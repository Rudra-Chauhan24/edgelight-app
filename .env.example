# =====================================================================
# Edge Light - Commercial Licensing, Firestore & Razorpay Configuration
# =====================================================================
# When you set up your Firebase and Razorpay accounts, fill in these values.
# If left empty, Edge Light runs in secure offline 3-Day Free Trial mode!
# =====================================================================

# Firebase Project ID (from Firebase Console -> Project Settings)
FIREBASE_PROJECT_ID=edge-light-24

# Firebase Web API Key (from Firebase Console -> Project Settings -> General)
FIREBASE_API_KEY=AIzaSy...

# Firebase Auth Domain
FIREBASE_AUTH_DOMAIN=edge-light-24.firebaseapp.com

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=edge-light-24.firebasestorage.app

# Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=1048711466271

# Firebase Web App ID
FIREBASE_APP_ID=1:1048711466271:web:...

# Firebase Measurement ID
FIREBASE_MEASUREMENT_ID=G-79ZK0P075W

# Firestore Collection Name for devices & licenses (default: licenses)
FIRESTORE_COLLECTION=licenses

# Free Trial Duration in hours (default: 72 = 3 days)
TRIAL_DURATION_HOURS=72

# Custom Administrative Salt for cryptographic hardware binding (optional)
ADMIN_SECRET_SALT=EdgeLight-Secure-Vault-Core-Salt-2026

# =====================================================================
# Razorpay & Payment Gateway Configuration (Under ₹100 Pricing)
# =====================================================================
# Razorpay Key ID (optional, from Razorpay Dashboard -> API Keys)
RAZORPAY_KEY_ID=

# Direct Razorpay Payment Links (create in Razorpay Dashboard -> Payment Links)
# Plan 1: Monthly Pass — ₹29 / month
RAZORPAY_PAYMENT_LINK_MONTHLY=https://rzp.io/rzp/WY3lkA6

# Plan 2: 3-Month Quarter Pass — ₹49 / 3 months (~₹16/mo, Most Popular)
RAZORPAY_PAYMENT_LINK_QUARTERLY=https://rzp.io/rzp/01mOm4K

# Plan 3: Lifetime Pro — ₹99 One-Time (Best Value)
RAZORPAY_PAYMENT_LINK_LIFETIME=https://rzp.io/rzp/K30Pa9v

# UPI Virtual Payment Address (VPA) for scan-to-pay QR codes (e.g. yourname@okhdfcbank or upi)
RAZORPAY_UPI_ID=edgelight@upi
